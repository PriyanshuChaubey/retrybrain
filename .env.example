# Pick your LLM provider and set the matching key.
LLM_PROVIDER=openai            # openai | anthropic | gemini
LLM_MODEL=gpt-4o-mini          # e.g. gpt-4o-mini | claude-3-5-sonnet | gemini-1.5-flash

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Recovery policy knobs (bounded workflow)
RETRY_THRESHOLD=0.35
MAX_ATTEMPTS=3
QUIET_HOURS=21-08              # no customer comms 9pm-8am local (compliance)
